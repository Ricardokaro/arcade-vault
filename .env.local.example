# Copia este archivo a .env.local y completa los valores reales.
# .env.local nunca se commitea (ver .gitignore).

# API key de Resend (https://resend.com/api-keys). Necesaria para que
# /api/contacto pueda enviar correos.
RESEND_API_KEY=

# Correo que recibe los mensajes del formulario de contacto de /acerca-de.
CONTACT_TO_EMAIL=

# Credenciales del proyecto de Supabase (Settings → API en el dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
